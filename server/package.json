{
  "name": "focus-app-server",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --remote --port 8787",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute focus-db --local --file=./drizzle/generated.sql",
    "db:migrate:remote": "wrangler d1 execute focus-db --remote --file=./drizzle/generated.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.2",
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250914.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.34.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  }
}
